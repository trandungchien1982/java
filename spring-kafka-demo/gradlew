#!/usr/bin/env bash
set -euo pipefail

GRADLE_VERSION="8.10.2"
PROJECT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
GRADLE_HOME="$PROJECT_DIR/.gradle-local/gradle-$GRADLE_VERSION"
GRADLE_BIN="$GRADLE_HOME/bin/gradle"
GRADLE_ZIP="$PROJECT_DIR/.gradle-local/gradle-$GRADLE_VERSION-bin.zip"
GRADLE_URL="https://services.gradle.org/distributions/gradle-$GRADLE_VERSION-bin.zip"

if [ ! -x "$GRADLE_BIN" ]; then
  mkdir -p "$PROJECT_DIR/.gradle-local"

  if [ ! -f "$GRADLE_ZIP" ]; then
    echo "Downloading Gradle $GRADLE_VERSION..."
    if command -v curl >/dev/null 2>&1; then
      curl -fL "$GRADLE_URL" -o "$GRADLE_ZIP"
    elif command -v wget >/dev/null 2>&1; then
      wget "$GRADLE_URL" -O "$GRADLE_ZIP"
    else
      echo "ERROR: curl or wget is required to download Gradle." >&2
      exit 1
    fi
  fi

  echo "Extracting Gradle $GRADLE_VERSION..."
  if command -v unzip >/dev/null 2>&1; then
    unzip -q "$GRADLE_ZIP" -d "$PROJECT_DIR/.gradle-local"
  else
    echo "ERROR: unzip is required to extract Gradle." >&2
    exit 1
  fi
fi

exec "$GRADLE_BIN" "$@"
